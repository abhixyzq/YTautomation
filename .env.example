# ==========================================
# 100% FREE AI AVATAR SHORTS PIPELINE CONFIG
# ==========================================

# 1. Google Gemini API Key (100% Free - get it in 30 seconds at https://aistudio.google.com/)
# If empty, the pipeline will fallback to curated trending tech news scripts automatically!
GEMINI_API_KEY=

# 2. Pexels API Key (100% Free - https://www.pexels.com/api/ - for HD tech b-roll videos)
# If empty, the pipeline uses sleek generated cyber/code dynamic canvas backgrounds!
PEXELS_API_KEY=

# 3. Voice Settings (edge-tts - 100% Free, Unlimited, Studio Neural Quality)
# English options: en-US-ChristopherNeural (Authoritative tech doc), en-US-GuyNeural, en-US-AriaNeural
VOICE_NAME=en-US-ChristopherNeural
VOICE_RATE=+5%
VOICE_PITCH=+0Hz

# 4. Channel Settings
LANGUAGE=ENG
PUBLISH_MODE=PUBLIC

# 5. YouTube Data API v3 OAuth Settings (Optional, only needed when auto-uploading to YouTube)
# Place your 'client_secret.json' inside the root folder
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
